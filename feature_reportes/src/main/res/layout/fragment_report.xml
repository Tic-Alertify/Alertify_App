<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alertify_background">

    <!-- Mapa de fondo -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Encabezado de la pantalla -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/alertify_primary"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Nuevo Reporte"
            android:textAlignment="center"
            android:textColor="@color/alertify_text_light"
            android:textStyle="bold"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta de Feedback (Estilo Píldora/Etiqueta) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#213A66"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <TextView
            android:id="@+id/tvFeedbackMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Mi Ubicación (Relocalizado para no quedar oculto) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/alertify_background"
        app:tint="@color/alertify_primary"
        app:fabSize="normal"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/report_panel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel Estático de Reporte (Bottom) -->
    <!-- Botón Flotante para Cambiar Estilo del Mapa -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_toggle_map_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_brightness_light"
        app:backgroundTint="@color/alertify_primary"
        app:tint="@color/alertify_text_light"
        app:fabSize="mini"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/report_panel"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/report_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/alertify_primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Card.TopRounded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalles del Incidente"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/alertify_text_light"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona la categoría"
                android:textColor="#E0E0E0"
                android:textSize="13sp" />

            <!-- Selector Moderno de Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupIncidentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">
                
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRobo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    android:textColor="@color/chip_text_color"
                    android:text="Robo" />
                    
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAsalto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    android:textColor="@color/chip_text_color"
                    android:text="Asalto" />
                    
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSospechoso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    android:textColor="@color/chip_text_color"
                    android:text="Sospechoso" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Campo de Descripción (Límite 100 caracteres) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:counterEnabled="true"
                app:counterMaxLength="100"
                app:counterTextColor="@color/alertify_text_light"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/alertify_background"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/alertify_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Describe la situación brevemente..."
                    android:inputType="text"
                    android:textColor="@color/alertify_text_dark"
                    android:maxLength="100"
                    android:maxLines="3"
                    android:gravity="top"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendReport"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:text="ENVIAR REPORTE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/alertify_text_light"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/alertify_accent"
                app:elevation="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>